---
import { siteConfig } from "../config";
---

<section id="contact" class="py-16 max-w-6xl mx-auto px-6 sm:px-12">
  <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-10">
    Contact me
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    
    <!-- KOLOM KIRI: Tombol Sosial Media / Kontak -->
    <div class="flex flex-col gap-4">
      
      <!-- WhatsApp -->
      <a
        href="https://wa.me/6282311948598"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center py-4 px-6 border-2 border-gray-800 rounded-xl font-medium text-gray-800 hover:bg-gray-50 transition shadow-sm"
      >
        Whatsapp
      </a>

      <!-- Instagram -->
      <a
        href="https://instagram.com/unlxvbl/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center py-4 px-6 border-2 border-gray-800 rounded-xl font-medium text-gray-800 hover:bg-gray-50 transition shadow-sm"
      >
        Instagram
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/Zeshunzue"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center py-4 px-6 border-2 border-gray-800 rounded-xl font-medium text-gray-800 hover:bg-gray-50 transition shadow-sm"
      >
        Github
      </a>

      <!-- Email Link Langsung -->
      <a
        href="mailto:mderikautsar@gmail.com"
        class="flex items-center justify-center py-4 px-6 border-2 border-gray-800 rounded-xl font-medium text-gray-800 hover:bg-gray-50 transition shadow-sm"
      >
        Email
      </a>

    </div>

    <!-- KOLOM KANAN: Form Kirim Pesan -->
    <!-- Ganti 'your-form-id' dengan ID Formspree, atau gunakan email langsung untuk testing -->
    <form
      action="https://formspree.io/f/xqpalqbz"
      method="POST"
      class="flex flex-col gap-4"
    >
      <!-- Input Alamat Email -->
      <div>
        <label for="sender-email" class="sr-only">Alamat email</label>
        <input
          type="email"
          name="email"
          id="sender-email"
          required
          placeholder="(alamat email yang ingin mengirim)"
          class="w-full px-4 py-3.5 border-2 border-gray-800 rounded-xl text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
        />
      </div>

      <!-- Textarea Isi Pesan -->
      <div>
        <label for="message" class="sr-only">Isi pesan</label>
        <textarea
          name="message"
          id="message"
          rows="6"
          required
          placeholder="Isi pesan"
          class="w-full px-4 py-3.5 border-2 border-gray-800 rounded-xl text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition resize-none"
        ></textarea>
      </div>

      <!-- Tombol Kirim -->
      <button
        type="submit"
        class="w-full py-3.5 px-6 rounded-xl font-bold text-white transition shadow-md hover:opacity-90 active:scale-[0.99]"
        style={`background-color: ${siteConfig.accentColor || '#7c3aed'}`}
      >
        Kirim Pesan
      </button>
    </form>

  </div>
</section>