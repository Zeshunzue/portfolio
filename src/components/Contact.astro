---
import { siteConfig } from "../config";
---

<section
  id="contact"
  class="relative isolate overflow-hidden bg-white py-16 px-6 sm:px-12 md:px-24"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="mx-auto flex flex-col md:flex-row gap-8 md:gap-16 items-start">
    
    <!-- SISI KIRI: Judul Section (Sejajar & seukuran dengan Education/Projects) -->
    <div class="w-full md:w-1/3 shrink-0">
      <h2 class="relative inline-block text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-900">
        Contact me
        <!-- Garis aksen di bawah judul persis seperti Education -->
        <span
          class="absolute left-0 -bottom-2 h-1.5 w-16 rounded-full"
          style={`background-color: ${siteConfig.accentColor || '#a855f7'}`}
        ></span>
      </h2>
    </div>

    <!-- SISI KANAN: Isi Form & Tombol Kontak -->
    <div class="w-full md:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
      
      <!-- Kolom Tombol Sosial Media / Tautan Kontak -->
      <div class="flex flex-col gap-4">
        <!-- WhatsApp -->
        <a
          href="https://wa.me/6282311948598"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center py-3 px-6 border-2 border-gray-900 rounded-xl font-medium text-gray-900 hover:bg-gray-50 transition shadow-sm"
        >
          Whatsapp
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com/unlxvbl/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center py-3 px-6 border-2 border-gray-900 rounded-xl font-medium text-gray-900 hover:bg-gray-50 transition shadow-sm"
        >
          Instagram
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/Zeshunzue"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center py-3 px-6 border-2 border-gray-900 rounded-xl font-medium text-gray-900 hover:bg-gray-50 transition shadow-sm"
        >
          Github
        </a>

        <!-- Email Langsung -->
        <a
          href="mailto:mderikautsar@gmail.com"
          class="flex items-center justify-center py-3 px-6 border-2 border-gray-900 rounded-xl font-medium text-gray-900 hover:bg-gray-50 transition shadow-sm"
        >
          Email
        </a>
      </div>

      <!-- Kolom Form Pesan -->
      <form
        action="https://formspree.io/f/xqpalqbz"
        method="POST"
        class="flex flex-col gap-4"
      >
        <!-- Input Email -->
        <div>
          <label for="contact-sender-email" class="sr-only">Alamat email</label>
          <input
            type="email"
            name="email"
            id="contact-sender-email"
            required
            placeholder="Your Email"
            class="w-full px-4 py-3 border-2 border-gray-900 rounded-xl text-gray-900 placeholder-gray-500 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
          />
        </div>

        <!-- Textarea Pesan -->
        <div>
          <label for="contact-sender-message" class="sr-only">Isi pesan</label>
          <textarea
            name="message"
            id="contact-sender-message"
            rows="6"
            required
            placeholder="Isi pesan"
            class="w-full px-4 py-3 border-2 border-gray-900 rounded-xl text-gray-900 placeholder-gray-500 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 transition resize-none"
          ></textarea>
        </div>

        <!-- Tombol Kirim -->
        <button
          type="submit"
          class="w-full py-3 px-6 rounded-xl font-semibold text-white transition shadow-md hover:opacity-90 active:scale-[0.99]"
          style={`background-color: ${siteConfig.accentColor || '#a855f7'}`}
        >
          Kirim Pesan
        </button>
      </form>

    </div>

  </div>
</section>